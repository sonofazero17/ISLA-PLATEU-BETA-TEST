# Copy to .env for LOCAL development only (npm run dev reads it). NEVER commit .env, and never put real values in this file.
# On Render, set these under: service -> Environment.

NODE_ENV=development
PORT=3000

# Administrator (canonical email is admin@islaplateu.local). The password is used ONLY to create the account the first time.
ADMIN_PASSWORD=
# Emergency recovery: set to a NEW password to reset the administrator password once, then remove it.
ADMIN_PASSWORD_RESET=

# Where the SQLite database lives. On Render, use a path on a persistent disk, e.g. /var/data/islaplateu.db
DB_PATH=

# Optional
# TRUST_PROXY_HOPS=1                 (reverse proxies in front of the app; Render = 1, automatic)
# OSRM_URL=https://your-routing-server
# TILE_URL_TEMPLATE=https://tiles.example.com/{z}/{x}/{y}.png?key=YOUR_DOMAIN_RESTRICTED_KEY
# TILE_ATTRIBUTION=Example Maps
