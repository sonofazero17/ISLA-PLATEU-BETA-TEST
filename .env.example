# Copy to .env for LOCAL development only (npm run dev reads it). NEVER commit .env, and never put real values in this file.
# On Render, set these under: service -> Environment.

NODE_ENV=development
PORT=3000

# Administrator (canonical email is admin@islaplateu.local). The password is used ONLY to create the account the first time.
ADMIN_PASSWORD=
# Emergency recovery: set to a NEW password to reset the administrator password once, then remove it.
ADMIN_PASSWORD_RESET=

# Where the SQLite database lives. On Render, use a path on a persistent disk, e.g. /var/data/islaplateu.db
DB_PATH=

# Optional
# TRUST_PROXY_HOPS=1                 (reverse proxies in front of the app; Render = 1, automatic)
# OSRM_URL=https://your-routing-server
# TILE_URL_TEMPLATE=https://tiles.example.com/{z}/{x}/{y}.png?key=YOUR_DOMAIN_RESTRICTED_KEY
# TILE_ATTRIBUTION=Example Maps

# ---- Email verification (Phase 8). Leave unset to keep sign-up working without verification. ----
# Option A: Gmail. Turn on 2-Step Verification in your Google account, create an "App password" (Google Account > Security > App passwords),
#           and use it below. Do NOT use your normal Gmail password. NOTE: some hosts (including Render's free plan) block outgoing SMTP.

# MAIL_PROVIDER=gmail
# Preferred names for Gmail account recovery (aliases SMTP_USER / SMTP_PASS are also supported).
# EMAIL_USER=your.address@gmail.com
# EMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# MAIL_FROM=ISLA-PLATEU <your.address@gmail.com>
# Option B: any SMTP server (587 = STARTTLS, 465 = TLS).
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# MAIL_FROM=ISLA-PLATEU <no-reply@your-domain>
# Option C (works where SMTP is blocked): an email API over HTTPS. Verify your sending address/domain with the provider first.
# MAIL_PROVIDER=resend            (or brevo)
# RESEND_API_KEY=...              (or BREVO_API_KEY=...)
# MAIL_FROM=ISLA-PLATEU <no-reply@your-verified-domain>
# Optional: a long random string used to hash email-verification and account-recovery codes (otherwise generated and stored in the database).
# EMAIL_CODE_SECRET=

# ---- CAPTCHA "I'm not a robot" (Phase 8). Leave unset to turn it off. ----
# CAPTCHA_PROVIDER=turnstile       (turnstile = Cloudflare Turnstile, free; or hcaptcha, recaptcha)
# CAPTCHA_SITE_KEY=...             (public key, shown in the page)
# CAPTCHA_SECRET_KEY=...           (secret key, server only: never commit it)
