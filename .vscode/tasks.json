{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto-push changes to GitHub",
      "type": "process",
      "command": "node",
      "args": ["scripts/auto-push.js"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^(.*)$",
            "message": 1
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Auto-push watcher started",
          "endsPattern": "Auto-push watcher stopped"
        }
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
